generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYNDIC
  RESIDENT
  OWNER
  ADMIN
  STAFF
}

enum UnitType {
  APARTMENT    // Apartamento
  STUDIO       // Studio/Kitnet
  COMMERCIAL   // Comercial/Sala
  HOUSE        // Casa
  LAND         // Terreno
  GARAGE       // Vaga de garagem
  STORAGE      // Depósito
  OTHER        // Outro

}

enum CategoryType {
  INCOME
  EXPENSE
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Condominium {
  id           String            @id @default(uuid())
  name         String
  cnpj         String?
  address      String
  monthlyFee   Float?
  createdAt    DateTime          @default(now())
  // ✅ Configurações de pagamento (agnóstico ao provedor)
  paymentProvider   String?   @default("ASAAS")
  paymentApiKey     String?
  paymentWalletId   String?
  paymentEnabled    Boolean   @default(false)
  units        Unit[]
  categories   AccountCategory[]
  expenses     Expense[]
  incomes      Income[]
  syndics      Person[]          @relation("SyndicOf")
  packages     Package[]
  notices      Notice[]
  spaces       Space[]
  documents    Document[]
  occurrences  Occurrence[]
  lostFounds   LostFound[]
  polls        Poll[]
  listings     Listing[]
  visitors     Visitor[]
  chatMessages ChatMessage[]
  accountingEntries AccountingEntry[]
  signatures   DocumentSignature[]
  inventory    InventoryItem[]
  assemblies   Assembly[]
  employees    Employee[]
  payments     Payment[]
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  bankStatements BankStatement[]
}

model Unit {
  id                  String               @id @default(uuid())
  condominiumId       String
  condominium         Condominium          @relation(fields: [condominiumId], references: [id])
  number              String
  floor               Int?
  type                UnitType             @default(APARTMENT)
  area                Float?
  ownerId             String?
  owner               Person?              @relation("UnitOwner", fields: [ownerId], references: [id])
  residents           Person[]             @relation("ResidentUnit")

  isActive            Boolean              @default(true)
  expenses            Expense[]
  incomes             Income[]
  maintenanceRequests MaintenanceRequest[]
  packages            Package[]
  reservations        Reservation[]
  occurrences         Occurrence[]
  visitors            Visitor[]
  payments            Payment[]
  parkingSpots        Int  @default(0)  // ✅ Vagas de garagem
}

model Person {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  phone               String?
  role                Role                 @default(RESIDENT)
  unitId              String?
  unit                Unit?                @relation("ResidentUnit", fields: [unitId], references: [id])
  ownedUnits          Unit[]               @relation("UnitOwner")
  syndicOfId          String?
  syndicOf            Condominium?         @relation("SyndicOf", fields: [syndicOfId], references: [id])
  maintenanceRequests MaintenanceRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  reservations        Reservation[]
  occurrences         Occurrence[]
  pets                Pet[]
  vehicles            Vehicle[]
  lostFounds          LostFound[]
  sentMessages        ChatMessage[]
  receivedMessages    ChatMessage[]        @relation("Receiver")
  listings            Listing[]
  votes               Vote[]
  signatures          DocumentSignature[]
  assemblyConfirmations AssemblyConfirmation[]
  asaasCustomerId     String?
   // ✅ Adicionar esta linha
  companyUsers        CompanyUser[]
}

model AccountCategory {
  id             String       @id @default(uuid())
  condominiumId  String
  condominium    Condominium  @relation(fields: [condominiumId], references: [id])
  name           String
  type           CategoryType
  icon           String?
  isDefault      Boolean      @default(false)
  expenses       Expense[]
  incomes        Income[]
  statementEntries StatementEntry[]
}

model Expense {
  id                    String          @id @default(uuid())
  condominiumId         String
  condominium           Condominium     @relation(fields: [condominiumId], references: [id])
  unitId                String?
  unit                  Unit?           @relation(fields: [unitId], references: [id])
  categoryId            String?
  category              AccountCategory? @relation(fields: [categoryId], references: [id])
  description           String
  amount                Float
  dueDate               DateTime
  paymentDate           DateTime?
  status                ExpenseStatus   @default(PENDING)
  recurrence            String?
  documentUrl           String?
  aiCategorySuggestion  Json?
  aiSuggestionConfirmed Boolean?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Income {
  id             String          @id @default(uuid())
  condominiumId  String
  condominium    Condominium     @relation(fields: [condominiumId], references: [id])
  unitId         String
  unit           Unit            @relation(fields: [unitId], references: [id])
  categoryId     String
  category       AccountCategory @relation(fields: [categoryId], references: [id])
  description    String
  amount         Float
  paymentDate    DateTime
  createdAt      DateTime        @default(now())
}

model MaintenanceRequest {
  id          String        @id @default(uuid())
  unitId      String?       // ✅ Agora é OPCIONAL
  unit        Unit?         @relation(fields: [unitId], references: [id])
  requesterId String
  requester   Person        @relation(fields: [requesterId], references: [id])
  title       String
  description String
  priority    Priority      @default(MEDIUM)
  status      RequestStatus @default(OPEN)
  scheduledTo DateTime?
  photos      String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Package {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  unitId         String
  unit           Unit        @relation(fields: [unitId], references: [id])
  description    String
  carrier        String?
  trackingCode   String?
  arrivedAt      DateTime    @default(now())
  retrievedAt    DateTime?
  retrievedBy    String?
  status         String      @default("PENDING")
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Notice {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  title          String
  content        String
  category       String      @default("GENERAL")
  priority       String      @default("NORMAL")
  isActive       Boolean     @default(true)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Space {
  id             String         @id @default(uuid())
  condominiumId  String
  condominium    Condominium    @relation(fields: [condominiumId], references: [id])
  name           String
  description    String?
  capacity       Int?
  price          Float?
  isActive       Boolean        @default(true)
  reservations   Reservation[]
}

model Reservation {
  id        String   @id @default(uuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id])
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  date      DateTime
  startTime String
  endTime   String
  purpose   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Document {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  title          String
  category       String      @default("OTHER")
  fileUrl        String
  fileSize       Int?
  uploadedAt     DateTime    @default(now())
}

model Occurrence {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  unitId         String?
  unit           Unit?       @relation(fields: [unitId], references: [id])
  personId       String
  person         Person      @relation(fields: [personId], references: [id])
  title          String
  description    String
  type           String      @default("COMPLAINT")
  status         String      @default("OPEN")
  response       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Pet {
  id       String @id @default(uuid())
  personId String
  person   Person @relation(fields: [personId], references: [id])
  name     String
  type     String @default("DOG")
  breed    String?
  color    String?
  photo    String?
}

model Vehicle {
  id       String @id @default(uuid())
  personId String
  person   Person @relation(fields: [personId], references: [id])
  brand    String
  model    String
  plate    String @unique
  color    String?
  year     Int?
}

model LostFound {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  personId       String
  person         Person      @relation(fields: [personId], references: [id])
  title          String
  description    String
  type           String      @default("FOUND")
  status         String      @default("OPEN")
  location       String?
  imageUrl       String?
  createdAt      DateTime    @default(now())
}

model ChatMessage {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  senderId       String
  sender         Person      @relation(fields: [senderId], references: [id])
  receiverId     String?
  receiver       Person?     @relation("Receiver", fields: [receiverId], references: [id])
  content        String
  isGroup        Boolean     @default(false)
  createdAt      DateTime    @default(now())
}

model Poll {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  title          String
  description    String?
  options        String[]
  expiresAt      DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  votes          Vote[]
}

model Vote {
  id        String   @id @default(uuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id])
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  option    Int
  createdAt DateTime @default(now())

  @@unique([pollId, personId])
}

model Listing {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  personId       String
  person         Person      @relation(fields: [personId], references: [id])
  title          String
  description    String
  price          Float?
  type           String      @default("SERVICE")
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
}

model Visitor {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  unitId         String
  unit           Unit        @relation(fields: [unitId], references: [id])
  name           String
  document       String?
  reason         String?
  entryAt        DateTime    @default(now())
  exitAt         DateTime?
  authorizedBy   String
  status         String      @default("ACTIVE")
}
model AccountingEntry {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  description    String
  amount         Float
  date           DateTime
  type           String      @default("EXPENSE")
  source         String      @default("CONDONET") // CONDONET (sistema) ou ACCOUNTANT (contador)
  reconciled     Boolean     @default(false)
  originalId     String?     // ID do lançamento original (se importado)
  difference     Float?      // Diferença entre sistema e contador
  notes          String?
  createdAt      DateTime    @default(now())
}
model DocumentSignature {
  id             String    @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id]) // ✅ Adicionar esta linha
  documentId     String
  personId       String
  person         Person    @relation(fields: [personId], references: [id])
  signatureData  String    // Base64
  ip             String?
  signedAt       DateTime  @default(now())
}
model InventoryItem {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  name           String
  category       String      @default("LIMPEZA")
  quantity       Int         @default(0)
  minQuantity    Int         @default(5)
  unit           String      @default("un")
  price          Float?
  supplier       String?
  lastPurchaseAt DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
model Assembly {
  id             String           @id @default(uuid())
  condominiumId  String
  condominium    Condominium      @relation(fields: [condominiumId], references: [id])
  title          String
  description    String?
  date           DateTime
  location       String?
  status         String           @default("SCHEDULED") // SCHEDULED, ONGOING, FINISHED
  minutesUrl     String?          // URL da ata
  createdAt      DateTime         @default(now())
  confirmations  AssemblyConfirmation[]
}

model AssemblyConfirmation {
  id          String    @id @default(uuid())
  assemblyId  String
  assembly    Assembly  @relation(fields: [assemblyId], references: [id])
  personId    String
  person      Person    @relation(fields: [personId], references: [id])
  status      String    @default("PENDING") // PENDING, PRESENT, ABSENT
  confirmedAt DateTime?
}

model Employee {
  id                String      @id @default(uuid())
  condominiumId     String
  condominium       Condominium @relation(fields: [condominiumId], references: [id])
  
  // 📋 DADOS PESSOAIS (Padrão CTPS)
  name              String
  dataNascimento    DateTime?
  localNascimento   String?
  pais              String      @default("BRASIL")
  estadoCivil       String?
  nomeMae           String?
  nomePai           String?
  grauInstrucao     String?
  sexo              String?
  deficiencia       Boolean     @default(false)
  deficienciaTipo   String?
  
  // 📄 DOCUMENTOS
  cpf               String?
  pis               String?
  ctpsNumero        String?
  ctpsSerie         String?
  ctpsUf            String?
  rg                String?
  rgEmissor         String?
  tituloEleitor     String?
  
  // 🏠 RESIDÊNCIA
  endereco          String?
  cidade            String?
  uf                String?
  cep               String?
  telefone          String?
  celular           String?
  
  // 💼 DADOS DO CONTRATO
  cargo             String
  funcao            String?
  cbo               String?
  dataAdmissao      DateTime?
  dataDemissao      DateTime?
  salarioBase       Float       @default(0)
  horarioTrabalho   String?
  horarioIntervalo  String?
  opcaoFgts         DateTime?
  status            String      @default("ATIVO")
  
  // ⚙️ ADICIONAIS (CLT)
  periculosidade    Float       @default(0)
  adicionalNoturno  Float       @default(0)
  insalubridade     Float       @default(0)
  grauInsalubridade String?
  
  // 🎁 BENEFÍCIOS
  valeTransporte    Float       @default(0)
  valeRefeicao      Float       @default(0)
  planoSaude        Float       @default(0)
  planoOdonto       Float       @default(0)
  planoSaudeCobertura Int       @default(100)
  planoOdontoCobertura Int      @default(100)
  
  // ⏰ VARIÁVEIS
  horasExtras50     Float       @default(0)
  horasExtras100    Float       @default(0)
  faltas            Float       @default(0)
  dsr               Float       @default(0)
  
  // 📊 ENCARGOS EMPRESA
  fgtsEmpresa       Float       @default(0)
  inssEmpresa       Float       @default(0)
  rat               Float       @default(0)
  terceiros         Float       @default(0)
  
  // 📊 DESCONTOS FUNCIONÁRIO
  inssFuncionario   Float       @default(0)
  irrf              Float       @default(0)
  pensaoAlimenticia Float       @default(0)
  adiantamento      Float       @default(0)
  
  // 🧮 PROVISÕES
  provisaoFerias    Float       @default(0)
  provisao13        Float       @default(0)
  provisaoFgtsFerias Float      @default(0)
  provisaoFgts13    Float       @default(0)
  provisaoInssFerias Float      @default(0)
  provisaoInss13    Float       @default(0)
  
  // 💵 TOTAIS
  totalProventos    Float       @default(0)
  totalDescontos    Float       @default(0)
  totalLiquido      Float       @default(0)
  custoTotalEmpresa Float       @default(0)
  
  // 🌴 FÉRIAS
  feriasVencidas    Boolean     @default(false)
  feriasPeriodos    Json?       // [{aquisitivo: "...", gozo: "..."}]
  
  // 📅 OUTROS
  competencia       String?
  observacoes       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Payment {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  unitId         String
  unit           Unit        @relation(fields: [unitId], references: [id])
  description    String
  amount         Float
  dueDate        DateTime
  paymentDate    DateTime?
  type           String      @default("PIX") // PIX ou BOLETO
  status         String      @default("PENDING")
  asaasId        String?     @unique
  invoiceUrl     String?
  bankSlipUrl    String?
  pixQrCode      String?     @db.Text
  pixCopiaCola   String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
model Company {
  id            String        @id @default(uuid())
  name          String
  cnpj          String?       @unique
  email         String        @unique
  phone         String?
  logoUrl       String?
  // ✅ Relacionamentos
  users         CompanyUser[]
  condominiums  Condominium[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model CompanyUser {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  personId   String
  person     Person    @relation(fields: [personId], references: [id])
  role       String    @default("MEMBER") // OWNER, ADMIN, MEMBER, ACCOUNTANT
  createdAt  DateTime  @default(now())
}
model BankStatement {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  fileName       String
  fileUrl        String
  fileType       String      // PDF, IMAGE, XLSX, CSV, OFX
  bankName       String?
  periodStart    DateTime?
  periodEnd      DateTime?
  status         String      @default("PROCESSING") // PROCESSING, REVIEW, APPROVED
  processedAt    DateTime?
  approvedAt     DateTime?
  totalEntries   Int         @default(0)
  entries        StatementEntry[]
  createdAt      DateTime    @default(now())
}

model StatementEntry {
  id             String        @id @default(uuid())
  statementId    String
  statement      BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date           DateTime
  amount         Float
  description    String
  type           String        // CREDIT, DEBIT
  aiCategory     String?
  aiConfidence   Float?
  aiMatched      Boolean       @default(false)
  categoryId     String?
  category       AccountCategory? @relation(fields: [categoryId], references: [id])
  approved       Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())
}
