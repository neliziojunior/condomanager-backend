// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYNDIC
  RESIDENT
  OWNER
  ADMIN
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  STUDIO
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Condominium {
  id          String            @id @default(uuid())
  name        String
  cnpj        String?
  address     String
  monthlyFee  Float?
  createdAt   DateTime          @default(now())
  units       Unit[]
  categories  AccountCategory[]
  expenses    Expense[]
  incomes     Income[]
  syndics     Person[]          @relation("SyndicOf")
   packages       Package[]     // ← JÁ ADICIONE ESTA LINHA AQUI
     notices       Notice[]
     spaces        Space[]
    documents Document[]
}

model Unit {
  id                  String               @id @default(uuid())
  condominiumId       String
  condominium         Condominium          @relation(fields: [condominiumId], references: [id])
  number              String
  floor               Int?
  type                UnitType             @default(APARTMENT)
  area                Float?
  ownerId             String?
  owner               Person?              @relation("UnitOwner", fields: [ownerId], references: [id])
  residents           Person[]             @relation("ResidentUnit")
  isActive            Boolean              @default(true)
  expenses            Expense[]
  incomes             Income[]
  maintenanceRequests MaintenanceRequest[]
  packages       Package[]     // ← JÁ ADICIONE ESTA LINHA AQUI
  reservations    Reservation[]
}

model Person {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  phone               String?
  role                Role                 @default(RESIDENT)
  unitId              String?
  unit                Unit?                @relation("ResidentUnit", fields: [unitId], references: [id])
  ownedUnits          Unit[]               @relation("UnitOwner")
  syndicOfId          String?
  syndicOf            Condominium?         @relation("SyndicOf", fields: [syndicOfId], references: [id])
  maintenanceRequests MaintenanceRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  reservations        Reservation[]
}

model AccountCategory {
  id             String       @id @default(uuid())
  condominiumId  String
  condominium    Condominium  @relation(fields: [condominiumId], references: [id])
  name           String
  type           CategoryType
  icon           String?
  isDefault      Boolean      @default(false)
  expenses       Expense[]
  incomes        Income[]
}

model Expense {
  id                       String          @id @default(uuid())
  condominiumId            String
  condominium              Condominium     @relation(fields: [condominiumId], references: [id])
  unitId                   String?
  unit                     Unit?           @relation(fields: [unitId], references: [id])
  categoryId               String?
  category                 AccountCategory? @relation(fields: [categoryId], references: [id])
  description              String
  amount                   Float
  dueDate                  DateTime
  paymentDate              DateTime?
  status                   ExpenseStatus   @default(PENDING)
  recurrence               String?
  documentUrl              String?
  aiCategorySuggestion     Json?
  aiSuggestionConfirmed    Boolean?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

model Income {
  id             String          @id @default(uuid())
  condominiumId  String
  condominium    Condominium     @relation(fields: [condominiumId], references: [id])
  unitId         String
  unit           Unit            @relation(fields: [unitId], references: [id])
  categoryId     String
  category       AccountCategory @relation(fields: [categoryId], references: [id])
  description    String
  amount         Float
  paymentDate    DateTime
  createdAt      DateTime        @default(now())
}

model MaintenanceRequest {
  id          String        @id @default(uuid())
  unitId      String
  unit        Unit          @relation(fields: [unitId], references: [id])
  requesterId String
  requester   Person        @relation(fields: [requesterId], references: [id])
  title       String
  description String
  priority    Priority      @default(MEDIUM)
  status      RequestStatus @default(OPEN)
  scheduledTo DateTime?
  photos      String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Package {
  id             String        @id @default(uuid())
  condominiumId  String
  condominium    Condominium   @relation(fields: [condominiumId], references: [id])
  unitId         String
  unit           Unit          @relation(fields: [unitId], references: [id])
  description    String
  carrier        String?       // transportadora (Correios, Amazon, etc)
  trackingCode   String?
  arrivedAt      DateTime      @default(now())
  retrievedAt    DateTime?
  retrievedBy    String?       // nome de quem retirou
  status         String        @default("PENDING") // PENDING, RETRIEVED
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Notice {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  title          String
  content        String
  category       String      @default("GENERAL")
  priority       String      @default("NORMAL")
  isActive       Boolean     @default(true)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Space {
  id             String            @id @default(uuid())
  condominiumId  String
  condominium    Condominium       @relation(fields: [condominiumId], references: [id])
  name           String
  description    String?
  capacity       Int?
  price          Float?
  isActive       Boolean           @default(true)
  reservations   Reservation[]
}

model Reservation {
  id          String      @id @default(uuid())
  spaceId     String
  space       Space       @relation(fields: [spaceId], references: [id])
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id])
  personId    String
  person      Person      @relation(fields: [personId], references: [id])
  date        DateTime
  startTime   String
  endTime     String
  purpose     String?
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())
}

model Document {
  id             String      @id @default(uuid())
  condominiumId  String
  condominium    Condominium @relation(fields: [condominiumId], references: [id])
  title          String
  category       String      @default("OTHER")
  fileUrl        String
  fileSize       Int?
  uploadedAt     DateTime    @default(now())
}